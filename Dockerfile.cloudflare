FROM node:24-bookworm-slim

ENV NODE_ENV=production \
    PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1
WORKDIR /app

RUN apt-get update \
 && apt-get install -y --no-install-recommends python3 python3-venv ca-certificates \
 && rm -rf /var/lib/apt/lists/*
COPY services/hedger/requirements.txt /tmp/hyperliquid-requirements.txt
RUN python3 -m venv /opt/hyperliquid \
 && /opt/hyperliquid/bin/pip install --no-cache-dir -r /tmp/hyperliquid-requirements.txt
COPY package.json package-lock.json ./
RUN npm ci --include=dev --ignore-scripts
COPY packages ./packages
COPY services ./services
COPY scripts ./scripts

EXPOSE 4100 4201 4202 4203 4300 4400 4500
CMD ["node", "--import", "tsx", "scripts/cloudflare-container.ts"]
