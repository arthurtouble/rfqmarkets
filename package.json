{
  "name": "rfq-markets-design",
  "private": true,
  "type": "module",
  "scripts": {
    "compile:contracts": "node scripts/compile-contracts.mjs",
    "validate:upgrades": "npm run compile:contracts && openzeppelin-upgrades-core validate artifacts/build-info --contract RFQClearing --unsafeAllowLinkedLibraries",
    "test:contracts": "npm run compile:contracts && hardhat run --no-compile --network hardhatOp scripts/contract-e2e.mjs && hardhat run --no-compile --network hardhatOp scripts/clearing-e2e.mjs && hardhat run --no-compile --network hardhatOp scripts/stateful-clearing-e2e.mjs",
    "test:python": "cd simulator && PYTHONDONTWRITEBYTECODE=1 python3 -B -m unittest discover -v",
    "test:services": "node --import tsx --test services/**/*.test.ts scripts/*.test.ts",
    "typecheck": "tsc",
    "build:web": "vite build apps/web --outDir ../../dist/web --emptyOutDir",
    "build:admin": "vite build apps/admin --outDir ../../dist/admin --emptyOutDir",
    "dev:services": "tsx scripts/local-stack.ts",
    "dev:testnet-services": "tsx scripts/base-sepolia-stack.ts",
    "dev:web": "vite apps/web",
    "dev:admin": "vite apps/admin",
    "dev:chain": "hardhat --verbosity 0 node --network hardhatOp --hostname 127.0.0.1 --port 8545",
    "deploy:local": "node --import tsx scripts/deploy-local.ts",
    "prepare:base-sepolia": "node --import tsx scripts/prepare-testnet-identities.ts",
    "deploy:base-sepolia-governance": "npm run compile:contracts && node --import tsx scripts/deploy-testnet-governance.ts",
    "finalize:base-sepolia-governance": "node --import tsx scripts/finalize-testnet-governance.ts",
    "preflight:base-sepolia": "node --import tsx scripts/preflight-base-sepolia.ts",
    "probe:base-sepolia": "node --import tsx scripts/probe-base-sepolia.ts",
    "deploy:base-sepolia": "npm run compile:contracts && npm run preflight:base-sepolia && node --import tsx scripts/deploy-base-sepolia.ts",
    "verify:base-sepolia": "node --import tsx scripts/verify-base-sepolia.ts",
    "fund:base-sepolia": "node --import tsx scripts/fund-base-sepolia.ts",
    "bootstrap:base-sepolia-user": "node --import tsx scripts/bootstrap-base-sepolia-user.ts",
    "smoke:base-sepolia-pyth": "node --import tsx scripts/pyth-base-sepolia-smoke.ts",
    "smoke:base-sepolia-e2e": "node --import tsx scripts/base-sepolia-e2e.ts",
    "smoke:base-sepolia-hedge-e2e": "node --import tsx scripts/base-sepolia-hedge-e2e.ts",
    "smoke:hyperliquid-testnet": "node --import tsx scripts/hyperliquid-testnet-smoke.ts",
    "smoke:local": "node --import tsx scripts/live-smoke.ts",
    "smoke:reorg": "node --import tsx scripts/reorg-smoke.ts",
    "smoke:failover": "node --import tsx scripts/leader-failover-smoke.ts",
    "smoke:approver-outage": "node --import tsx scripts/approver-outage-smoke.ts",
    "smoke:sender-replacement": "node --import tsx scripts/sender-replacement-smoke.ts",
    "smoke:quote-load": "node --import tsx scripts/quote-load-smoke.ts",
    "smoke:adversarial-load": "node --import tsx scripts/adversarial-load.ts",
    "smoke:limit-order": "node --import tsx scripts/limit-order-smoke.ts",
    "smoke:live-market": "node --import tsx scripts/live-market-data-smoke.ts",
    "smoke:sse-gateway": "node --import tsx scripts/sse-gateway-load.ts",
    "test": "npm run test:contracts && npm run validate:upgrades && npm run test:python && npm run test:services && npm run typecheck && npm run build:web && npm run build:admin"
  },
  "devDependencies": {
    "@fastify/cors": "11.3.0",
    "@nomicfoundation/hardhat-ethers": "4.0.15",
    "@openzeppelin/contracts": "5.6.1",
    "@openzeppelin/contracts-upgradeable": "5.6.1",
    "@openzeppelin/upgrades-core": "1.46.0",
    "@safe-global/protocol-kit": "8.0.7",
    "@types/node": "26.5.0",
    "@types/react": "19.2.18",
    "@types/react-dom": "19.2.7",
    "@vitejs/plugin-react": "6.1.1",
    "chai": "6.2.2",
    "ethers": "6.17.0",
    "fastify": "5.12.3",
    "hardhat": "3.16.0",
    "mocha": "12.0.0",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "solc": "0.8.34",
    "tsx": "4.23.13",
    "typescript": "7.0.2",
    "vite": "8.2.2",
    "zod": "3.25.76"
  },
  "overrides": {
    "tmp": "0.2.7"
  },
  "dependencies": {
    "@chainlink/data-streams-sdk": "1.2.1"
  }
}
