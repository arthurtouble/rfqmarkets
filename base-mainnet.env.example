# Copy to base-mainnet.env (ignored by Git) and keep it mode 0600. See docs/operations/base-mainnet.md.
RFQ_BASE_MAINNET_RPC_URL=https://replace-with-primary-base-mainnet-rpc
# Independent provider used to cross-verify the deployment.
RFQ_BASE_MAINNET_SECONDARY_RPC_URL=https://replace-with-independent-base-mainnet-rpc
# Fresh single-use deployer. It holds no protocol role after deployment; fund with ~0.01 ETH.
RFQ_MAINNET_DEPLOYER_KEY=0xreplace_with_fresh_deployer_key
# Optional: run preflight from an address alone, without loading the key.
# RFQ_MAINNET_DEPLOYER_ADDRESS=0x...
# Set only at broadcast time to the exact string the command prints.
# RFQ_MAINNET_DEPLOY_CONFIRM=
RFQ_BASESCAN_API_KEY=replace_with_etherscan_v2_api_key
