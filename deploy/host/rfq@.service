[Unit]
Description=RFQ isolated %i service
After=network-online.target
Wants=network-online.target
RequiresMountsFor=/var/lib/rfq
[Service]
Type=simple
User=rfq-%i
Group=rfq-%i
WorkingDirectory=/opt/rfq
Environment=NODE_ENV=production
ExecStart=/usr/bin/flock --exclusive --nonblock --no-fork /var/lib/rfq/%i/writer.lock /usr/local/bin/node --import tsx scripts/persistent-service.ts %i /etc/rfq/%i.json /etc/rfq/%i.secret.json
Restart=on-failure
RestartSec=5
TimeoutStopSec=45
UMask=0077
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/var/lib/rfq/%i
LimitNOFILE=8192
[Install]
WantedBy=multi-user.target
